# CodeSage PR Bot — Environment Variables
# Copy this file to .env and fill in your values

# From console.groq.com — free tier available
GROQ_API_KEY=gsk_your_key_here

# GitHub Personal Access Token
# Scopes needed: repo (full), read:user
# Create at: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_your_token_here

# Any random string — set the SAME value in your GitHub webhook settings
# Generate one: python -c "import secrets; print(secrets.token_hex(32))"
WEBHOOK_SECRET=your_random_secret_here

# Port for the FastAPI server (default: 8000)
PORT=8000

SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/slack/webhook/url 